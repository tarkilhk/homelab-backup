{
  "type": "object",
  "additionalProperties": false,
  "required": ["base_url", "api_key", "backup_directory"],
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "default": "http://sonarr.local:8989",
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "api_key": {
      "type": "string",
      "title": "API Key",
      "minLength": 1
    },
    "backup_directory": {
      "type": "string",
      "title": "Backup Directory",
      "default": "/sources/sonarr/backups",
      "const": "/sources/sonarr/backups",
      "minLength": 1,
      "pattern": "^/.*"
    }
  }
}
