{
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "host", "port", "database", "user", "password"],
  "properties": {
    "mode": {
      "type": "string",
      "title": "Mode",
      "enum": ["source", "restore_destination"]
    },
    "host": {
      "type": "string",
      "title": "PostgreSQL host",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "title": "PostgreSQL port",
      "minimum": 1,
      "maximum": 65535,
      "default": 5432
    },
    "database": {
      "type": "string",
      "title": "Cal.com database",
      "minLength": 1
    },
    "user": {
      "type": "string",
      "title": "PostgreSQL user",
      "minLength": 1
    },
    "password": {
      "type": "string",
      "title": "PostgreSQL password",
      "minLength": 1
    }
  }
}
