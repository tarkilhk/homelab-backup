{
  "type": "object",
  "required": ["base_url", "api_key", "backup_path"],
  "properties": {
    "base_url": {"type": "string", "format": "uri", "title": "Base URL", "default": "http://jellyfin.local"},
    "api_key": {"type": "string", "title": "API Key", "default": "your_api_key"},
    "backup_path": {
      "type": "string",
      "title": "Shared Jellyfin backup directory",
      "default": "/jellyfin-backups"
    }
  }
}
