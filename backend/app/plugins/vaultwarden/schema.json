{
  "type": "object",
  "additionalProperties": false,
  "required": ["container_name", "allow_service_stop"],
  "properties": {
    "container_name": {
      "type": "string",
      "title": "Container Name",
      "default": "vaultwarden",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "allow_service_stop": {
      "type": "boolean",
      "title": "Allow Vaultwarden Stop During Backup",
      "const": true,
      "default": true
    }
  }
}
